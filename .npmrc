# @flue/opentelemetry@2.0.4 publishes a peerDependencies entry of
# `@flue/runtime: "workspace:^"` — a pnpm/npm workspace-protocol range that
# should have been rewritten to a real semver range at publish time and
# wasn't (verified via `npm view @flue/opentelemetry@2.0.4 peerDependencies`).
# Plain `npm install`/`npm ci` treats that as an installable spec and fails
# with EUNSUPPORTEDPROTOCOL before ever reaching the real (already-satisfied
# — @flue/runtime is a normal dependency here) peer. `legacy-peer-deps`
# skips npm's peer-resolution step entirely, which is the only known
# workaround short of patching the upstream package. Revisit (and drop this
# file) once a fixed @flue/opentelemetry ships.
legacy-peer-deps=true
