    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6",
    "oxlint": "^1",
    "typescript": "^5.7.2",
    "vite": "^7",
    "vue-tsc": "^3"
  }
}
