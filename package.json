{
  "name": "@gr8ful/spf",
  "version": "0.1.1",
  "description": "Super Portable Factory — a global CLI for repeatable agents-plus-code workflows (ADWs)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "spf": "dist/cli/bin.js"
  },
  "files": [
    "dist",
    "web",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/index.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build:cli": "tsc -p tsconfig.build.json && chmod +x dist/cli/bin.js",
    "build:app": "npm --prefix app ci && npm --prefix app run build",
    "build": "npm run clean && npm run build:cli && npm run build:app",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build:cli",
    "test": "node --test \"dist/**/*.test.js\"",
    "prepack": "node scripts/check-pack-ready.js",
    "size-check": "node scripts/check-tarball-size.js"
  },
  "dependencies": {
    "@flue/runtime": "2.0.3",
    "@hono/node-server": "^2.1.1",
    "@valibot/to-json-schema": "^1.7.1",
    "hono": "^4.13.3",
    "valibot": "^1.4.2",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2"
  }
}
