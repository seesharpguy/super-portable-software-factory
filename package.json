{
  "name": "@grateful8/sf",
  "version": "0.1.0",
  "description": "G8 Software Factory — a global CLI for repeatable agents-plus-code workflows (ADWs)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "sf": "dist/cli/bin.js",
    "g8sf": "dist/cli/bin.js"
  },
  "files": [
    "dist",
    "web",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/index.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:cli": "tsc -p tsconfig.build.json",
    "build": "npm run clean && npm run build:cli",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@flue/runtime": "2.0.3",
    "@valibot/to-json-schema": "^1.7.1",
    "valibot": "^1.4.2",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^7.0.2"
  }
}
